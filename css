:root{
  --bg:#0b0c0e;
  --bg2:#0f1114;
  --panel:#12151a;
  --line: rgba(255,255,255,.08);

  --text: rgba(255,255,255,.92);
  --muted: rgba(255,255,255,.62);

  --gold:#c8b27a;   /* champagne */
  --gold2:#e2d3a1;

  --r: 22px;
  --r2: 32px;
  --shadow: 0 18px 60px rgba(0,0,0,.55);

  --container: 1200px;
}

*{ margin:0; padding:0; box-sizing:border-box; font-family:'Poppins',sans-serif; }
html{ scroll-behavior:smooth; }
body{
  background:
    radial-gradient(900px 600px at 18% 8%, rgba(255,255,255,.06), transparent 60%),
    radial-gradient(800px 520px at 82% 18%, rgba(200,178,122,.08), transparent 62%),
    linear-gradient(180deg, var(--bg2), var(--bg));
  color: var(--text);
}

a{ color:inherit; text-decoration:none; }
.container{ max-width:var(--container); margin:0 auto; padding:0 24px; }
.muted{ color: var(--muted); }
.small{ font-size:12px; }

.kicker{
  font-size:11px;
  letter-spacing:5px;
  text-transform:uppercase;
  color: rgba(255,255,255,.60);
}

/* Topbar */
.topbar{
  border-bottom:1px solid var(--line);
  background: rgba(0,0,0,.35);
  backdrop-filter: blur(16px);
}
.topbar-inner{
  display:flex;
  justify-content:center;
  gap:14px;
  padding:10px 0;
  font-size:12px;
  color: var(--muted);
}
.sep{
  width:1px;
  background: rgba(255,255,255,.12);
}

/* Header */
.header{
  position:sticky;
  top:0;
  z-index:50;
  border-bottom:1px solid var(--line);
  background: rgba(11,12,14,.65);
  backdrop-filter: blur(18px);
}
.nav{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px 0;
  gap:16px;
}
.brand img{ height:34px; }

.nav-links{
  display:flex;
  align-items:center;
  gap:10px;
}
.nav-links a{
  font-size:13px;
  color: rgba(255,255,255,.82);
  padding:10px 12px;
  border-radius:999px;
  transition:.25s;
}
.nav-links a:hover{
  background: rgba(255,255,255,.05);
  color: rgba(255,255,255,.95);
}

.nav-actions{ display:flex; align-items:center; gap:10px; }

/* Buttons */
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  padding:12px 18px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.05);
  color: rgba(255,255,255,.90);
  cursor:pointer;
  font-weight:700;
  letter-spacing:.2px;
  transition:.25s;
}
.btn:hover{ transform:translateY(-2px); background: rgba(255,255,255,.07); }

.btn-primary{
  border:none;
  background: linear-gradient(180deg, #ffffff, #dcdcdc);
  color:#0b0c0e;
}
.btn-primary:hover{ opacity:.95; }

.btn-ghost{ background: rgba(255,255,255,.04); }
.btn-gold{
  border:none;
  background: linear-gradient(180deg, var(--gold2), var(--gold));
  color:#0b0c0e;
}
.badge{
  min-width:24px;
  height:24px;
  padding:0 8px;
  border-radius:999px;
  background: rgba(0,0,0,.35);
  border:1px solid rgba(255,255,255,.10);
  color: rgba(255,255,255,.92);
  font-size:12px;
}

/* Hero */
.hero{
  padding:78px 0 30px;
  display:grid;
  grid-template-columns: 1.1fr .9fr;
  gap:56px;
  align-items:center;
}
.hero h1{
  font-size:58px;
  line-height:1.02;
  margin:16px 0 14px;
  letter-spacing:-1px;
}
.hero h1 span{
  background: linear-gradient(180deg, var(--gold2), var(--gold));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.hero p{
  color: var(--muted);
  max-width:520px;
  line-height:1.75;
}
.hero-actions{ display:flex; gap:12px; margin:22px 0 26px; flex-wrap:wrap; }

.hero-meta{
  display:flex;
  gap:14px;
  flex-wrap:wrap;
}
.meta{
  background: rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:18px;
  padding:14px 16px;
}
.meta-title{ font-weight:800; }
.meta-sub{ margin-top:2px; font-size:12px; color: var(--muted); }

.hero-frame{
  background: rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.10);
  border-radius: var(--r2);
  padding:14px;
  box-shadow: var(--shadow);
}
.hero-frame img{
  width:100%;
  height:420px;
  object-fit:cover;
  border-radius: 26px;
  border:1px solid rgba(255,255,255,.08);
  display:block;
}

/* Sections */
.section{ padding:90px 0 0; }
.section-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:16px;
  flex-wrap:wrap;
  margin-bottom:18px;
}
.section-head h2{
  font-size:34px;
  letter-spacing:-.5px;
  margin-top:10px;
}
.right-tools{ display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }

.search{
  width:240px;
  padding:12px 14px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  color: var(--text);
  outline:none;
}
.select{
  padding:12px 14px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  color: var(--text);
  outline:none;
}

/* Story */
.story{
  background: rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.10);
  border-radius: var(--r2);
  padding:58px 44px;
  box-shadow: var(--shadow);
}
.story h2{ font-size:40px; margin:12px 0 10px; }
.story-grid{
  margin-top:22px;
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:14px;
}
.panel{
  background: rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.10);
  border-radius: var(--r);
  padding:18px;
}
.panel h3{ font-size:16px; margin-bottom:6px; }
.panel p{ line-height:1.65; }

/* Products */
.grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:14px;
}
.card{
  background: rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.10);
  border-radius: var(--r2);
  overflow:hidden;
  transition:.35s;
}
.card:hover{
  transform: translateY(-8px);
  box-shadow: 0 18px 55px rgba(0,0,0,.55);
  border-color: rgba(255,255,255,.14);
}
.card img{
  width:100%;
  height:260px;
  object-fit:cover;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.card .body{ padding:16px; }
.card .title{ font-weight:800; }
.card .desc{ font-size:12px; color: var(--muted); margin-top:6px; min-height:34px; }
.card .row{ display:flex; justify-content:space-between; align-items:center; margin-top:12px; }
.price{ font-weight:900; letter-spacing:.2px; }
.tag{
  font-size:11px;
  padding:6px 10px;
  border-radius:999px;
  border:1px solid rgba(200,178,122,.25);
  background: rgba(200,178,122,.10);
  color: rgba(226,211,161,.95);
}
.add{
  margin-top:12px;
  width:100%;
  padding:12px 14px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.05);
  color: rgba(255,255,255,.92);
  font-weight:800;
  cursor:pointer;
  transition:.25s;
}
.add:hover{ transform:translateY(-2px); background: rgba(255,255,255,.07); }

/* Members */
.members{
  display:grid;
  grid-template-columns: 1.1fr .9fr;
  gap:14px;
  align-items:start;
}
.form{ display:flex; flex-direction:column; gap:10px; margin-top:10px; }
.form label{ font-size:12px; color: var(--muted); }
.form input{
  padding:14px 14px;
  border-radius:16px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.03);
  color: var(--text);
  outline:none;
}
.form input:focus{
  border-color: rgba(200,178,122,.45);
  box-shadow: 0 0 0 4px rgba(200,178,122,.10);
}
.row{ display:flex; justify-content:space-between; align-items:center; gap:10px; }
.label{ font-size:12px; color: var(--muted); }
.value{ font-weight:800; margin-top:3px; }

/* Footer */
.footer{
  margin-top:90px;
  border-top:1px solid var(--line);
  background: rgba(0,0,0,.30);
}
.footer-inner{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:18px;
  padding:36px 0 18px;
  flex-wrap:wrap;
}
.footer-logo{ height:34px; margin-bottom:10px; }
.footer-links{ display:flex; flex-direction:column; gap:10px; color: rgba(255,255,255,.80); }
.footer-links a:hover{ color: rgba(226,211,161,.95); }
.footer-bottom{
  display:flex;
  justify-content:space-between;
  gap:10px;
  padding:16px 0 18px;
  border-top:1px solid var(--line);
  color: rgba(255,255,255,.75);
  flex-wrap:wrap;
}

/* Drawer */
.overlay{
  position:fixed; inset:0;
  background: rgba(0,0,0,.60);
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:80;
}
.overlay.show{ opacity:1; pointer-events:auto; }

.drawer{
  position:fixed;
  top:0; right:0;
  width:420px;
  height:100vh;
  background: rgba(12,14,18,.78);
  border-left:1px solid rgba(255,255,255,.10);
  backdrop-filter: blur(18px);
  transform: translateX(110%);
  transition:.25s;
  z-index:90;
  display:flex;
  flex-direction:column;
}
.drawer.show{ transform: translateX(0); }

.drawer-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 16px 12px;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.drawer-title{ font-size:18px; font-weight:900; }
.x{
  width:42px; height:42px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  color: var(--text);
  cursor:pointer;
  font-size:20px;
}
.drawer-body{ padding:14px 16px; overflow:auto; flex:1; }
.drawer-foot{ padding:14px 16px 16px; border-top:1px solid rgba(255,255,255,.08); }
.total-row{ display:flex; justify-content:space-between; align-items:center; padding:8px 0; }
.drawer-actions{ display:flex; gap:10px; margin-top:10px; }

/* Cart items */
.cart-item{
  display:grid;
  grid-template-columns: 62px 1fr auto;
  gap:12px;
  padding:12px;
  border-radius:18px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.03);
  margin-bottom:10px;
}
.cart-item img{
  width:62px; height:62px;
  border-radius:16px;
  object-fit:cover;
  border:1px solid rgba(255,255,255,.08);
}
.cart-item h4{ font-size:14px; margin-bottom:4px; }
.cart-item .meta{ font-size:12px; color: var(--muted); }
.qty{
  display:flex; align-items:center; gap:8px;
  margin-top:8px;
}
.qbtn{
  width:28px; height:28px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.04);
  color: var(--text);
  cursor:pointer;
}
.rmv{
  border:none;
  background:transparent;
  color: rgba(255,255,255,.70);
  cursor:pointer;
  font-size:18px;
  padding:6px 8px;
}
.rmv:hover{ color: rgba(226,211,161,.95); }

/* Toast */
.toast{
  position: fixed;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%) translateY(20px);
  background: rgba(0,0,0,.70);
  border:1px solid rgba(255,255,255,.12);
  color: rgba(255,255,255,.92);
  padding:12px 14px;
  border-radius:999px;
  backdrop-filter: blur(18px);
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:120;
}
.toast.show{ opacity:1; transform: translateX(-50%) translateY(0); }

@media (max-width: 1100px){
  .grid{ grid-template-columns: repeat(3, 1fr); }
  .story-grid{ grid-template-columns:1fr; }
}
@media (max-width: 900px){
  .hero{ grid-template-columns:1fr; }
  .members{ grid-template-columns:1fr; }
  .hero-frame img{ height:380px; }
}
@media (max-width: 520px){
  .grid{ grid-template-columns: 1fr; }
  .hero h1{ font-size:46px; }
  .drawer{ width:92vw; }
}
/* Login Modal */
.modal-overlay{
  position:fixed; inset:0;
  background: rgba(0,0,0,.60);
  opacity:0; pointer-events:none;
  transition:.25s;
  z-index:95;
}
.modal-overlay.show{ opacity:1; pointer-events:auto; }

.modal{
  position:fixed;
  left:50%; top:50%;
  transform: translate(-50%,-48%) scale(.98);
  width:min(520px, 92vw);
  background: rgba(12,14,18,.82);
  border:1px solid rgba(255,255,255,.10);
  border-radius: 24px;
  backdrop-filter: blur(18px);
  box-shadow: 0 20px 80px rgba(0,0,0,.65);
  padding:16px;
  opacity:0; pointer-events:none;
  transition:.25s;
  z-index:100;
}
.modal.show{
  opacity:1;
  pointer-events:auto;
  transform: translate(-50%,-50%) scale(1);
}
.modal-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:6px 6px 12px;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.modal-title{ font-size:18px; font-weight:900; }
.btn-ghost.logged{
  border-color: rgba(200,178,122,.35);
  background: rgba(200,178,122,.10);
  color: rgba(226,211,161,.95);
}
/* === Art Series (REFRACTION) === */
.art-frame{
  position:relative;
  background: #111;
  border-radius: 28px;
  padding:18px;
  border:1px solid rgba(255,255,255,.10);
  box-shadow: 0 30px 90px rgba(0,0,0,.65);
}

.art-frame img{
  width:100%;
  height:420px;
  object-fit:cover;
  border-radius: 20px;
  filter: contrast(1.05) saturate(.9);
}

/* label kecil (gallery style) */
.art-label{
  position:absolute;
  bottom:18px;
  left:18px;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(12px);
  border:1px solid rgba(255,255,255,.12);
  border-radius: 14px;
  padding:10px 14px;
}

.art-label span{
  font-size:10px;
  letter-spacing:3px;
  color: rgba(255,255,255,.65);
}

.art-label strong{
  display:block;
  font-size:14px;
  font-weight:700;
  margin-top:2px;
}
/* ============================= */
/* REFRACTION — ART SIGNATURE    */
/* ============================= */

.art-frame{
  position: relative;
}

.art-frame::after{
  content:"";
  position:absolute;
  inset:0;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,.35),
    rgba(0,0,0,.15),
    rgba(0,0,0,.35)
  );
  border-radius: inherit;
  pointer-events:none;
}

.art-caption{
  position: absolute;
  bottom: 16px;
  right: 20px;
  font-size: 11px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: rgba(255,255,255,.55);
  pointer-events: none;
}

